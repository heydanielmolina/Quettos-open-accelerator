# Yosys synth_xilinx (xc7) of the whole core, in both configurations. The
# design is flattened so that `ltp` walks real cells: an unflattened module
# instance is one node whose every input reaches every output, and the control
# loop between the dispatcher and the units would then read as a cycle.
# qcore_vpu_top is instantiated, so the vector unit -- its lanes, its scalar
# unit and the three lookup tables it loads -- is inside these numbers along
# with the GEMV, EMBED and KVWRITE datapath and the whole control path.
# ROM_FILE_SIGMOID, ROM_FILE_RSQRT and ROM_FILE_RECIP are the images $readmemh
# loads into the qcore_lut_rom instances; Yosys 0.65 resolves $readmemh while it
# reads a module, so `read_verilog -defer` holds the modules unelaborated and
# `chparam` supplies every parameter, the three paths first, before `hierarchy`
# propagates them. The paths are relative to the repo root, which is where the
# script runs.
# Run from the repo root:
#   mkdir -p build/synth && yosys -q -l build/synth/synth_top.log -s syn/synth_top.ys
# syn/report.ys prints, for each configuration, the cell table, the longest
# topological path and the hard-block instances that scripts/synth_report.py
# turns into syn/reports/qcore_top.md.
# Both configurations instantiate qcore_vpu_top, and qcore_top has no parameter
# that leaves it out, so the area of the core before it carried a vector unit is
# not a configuration here; the note in syn/reports/qcore_top.md names the commit
# whose own report records it.

# ---- demo: WB = 64, B_MAX = 1, VL = 4, VSRAM_WORDS = 4096
log ==== qreport config demo
read_verilog -sv -defer -Irtl rtl/qcore_pkg.sv rtl/qcore_csr.sv rtl/qcore_kv_writer.sv rtl/qcore_lut_interp.sv rtl/qcore_lut_rom.sv rtl/qcore_mac_lane_group.sv rtl/qcore_mem_arb.sv rtl/qcore_perf.sv rtl/qcore_requant.sv rtl/qcore_row.sv rtl/qcore_seq_dispatch.sv rtl/qcore_seq_fetch.sv rtl/qcore_stream_ctrl.sv rtl/qcore_vpu_lane.sv rtl/qcore_vpu_scalar.sv rtl/qcore_vpu_top.sv rtl/qcore_vsram.sv rtl/qcore_top.sv
chparam -set ROM_FILE_SIGMOID "rtl/gen/sigmoid.hex" -set ROM_FILE_RSQRT "rtl/gen/rsqrt.hex" -set ROM_FILE_RECIP "rtl/gen/recip.hex" -set WB 64 -set B_MAX 1 -set VL 4 -set VSRAM_WORDS 4096 -set FIFO_BEATS 128 -set ACC_W 40 -set META_FIFO_BEATS 16 -set MAX_BURST 64 -set DQ_DEPTH 8 -set VPU_FIFO_BEATS 16 qcore_top
hierarchy -check -top qcore_top
synth_xilinx -family xc7 -flatten -top qcore_top
script syn/report.ys

# ---- tiny: WB = 16, B_MAX = 2, VL = 2, VSRAM_WORDS = 2048
design -reset
log ==== qreport config tiny
read_verilog -sv -defer -Irtl rtl/qcore_pkg.sv rtl/qcore_csr.sv rtl/qcore_kv_writer.sv rtl/qcore_lut_interp.sv rtl/qcore_lut_rom.sv rtl/qcore_mac_lane_group.sv rtl/qcore_mem_arb.sv rtl/qcore_perf.sv rtl/qcore_requant.sv rtl/qcore_row.sv rtl/qcore_seq_dispatch.sv rtl/qcore_seq_fetch.sv rtl/qcore_stream_ctrl.sv rtl/qcore_vpu_lane.sv rtl/qcore_vpu_scalar.sv rtl/qcore_vpu_top.sv rtl/qcore_vsram.sv rtl/qcore_top.sv
chparam -set ROM_FILE_SIGMOID "rtl/gen/sigmoid.hex" -set ROM_FILE_RSQRT "rtl/gen/rsqrt.hex" -set ROM_FILE_RECIP "rtl/gen/recip.hex" -set WB 16 -set B_MAX 2 -set VL 2 -set VSRAM_WORDS 2048 -set FIFO_BEATS 128 -set ACC_W 40 -set META_FIFO_BEATS 16 -set MAX_BURST 64 -set DQ_DEPTH 8 -set VPU_FIFO_BEATS 16 qcore_top
hierarchy -check -top qcore_top
synth_xilinx -family xc7 -flatten -top qcore_top
script syn/report.ys
