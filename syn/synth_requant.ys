# Yosys synth_xilinx (xc7) of qcore_requant on its own, in both configurations.
# WB is the number of channels a tile carries, B_MAX the rows whose tile meta
# the replay buffer holds, ACC_W the accumulator width the first product reads,
# VSRAM_WORDS the write address width.
# Run from the repo root:
#   mkdir -p build/synth && yosys -q -l build/synth/synth_requant.log -s syn/synth_requant.ys
# syn/report.ys prints, for each configuration, the cell table, the longest
# topological path and the hard-block instances that scripts/synth_report.py
# turns into syn/reports/qcore_requant.md.

# ---- demo: WB = 64, B_MAX = 1, ACC_W = 40, VSRAM_WORDS = 4096
log ==== qreport config demo
read_verilog -sv -defer -Irtl rtl/qcore_pkg.sv rtl/qcore_requant.sv
chparam -set WB 64 -set B_MAX 1 -set ACC_W 40 -set VSRAM_WORDS 4096 qcore_requant
hierarchy -check -top qcore_requant
synth_xilinx -family xc7 -top qcore_requant
script syn/report.ys

# ---- tiny: WB = 16, B_MAX = 2, ACC_W = 40, VSRAM_WORDS = 2048
design -reset
log ==== qreport config tiny
read_verilog -sv -defer -Irtl rtl/qcore_pkg.sv rtl/qcore_requant.sv
chparam -set WB 16 -set B_MAX 2 -set ACC_W 40 -set VSRAM_WORDS 2048 qcore_requant
hierarchy -check -top qcore_requant
synth_xilinx -family xc7 -top qcore_requant
script syn/report.ys
