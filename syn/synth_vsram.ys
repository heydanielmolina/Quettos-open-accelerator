# Yosys synth_xilinx (xc7) of qcore_vsram on its own, default configuration
# (WORDS = 4096, W = 256, NE = 8). Run from the repo root:
#   mkdir -p build/synth && yosys -q -l build/synth/qcore_vsram_xc7.log -s syn/synth_vsram.ys
# The log ends with the cell table (stat -tech xilinx); the memory_libmap
# lines above it show the RAM mapped as a true-dual-port block RAM.
# Override the depth before hierarchy with `chparam -set WORDS 2048 qcore_vsram`.
read_verilog -sv -defer -Irtl rtl/qcore_vsram.sv
hierarchy -check -top qcore_vsram
synth_xilinx -family xc7 -top qcore_vsram
stat -tech xilinx
